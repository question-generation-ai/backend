# Database
DATABASE_URL="postgresql://username:password@localhost:5432/question_generator"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# API Keys
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"
# Recommended models (January 2026):
# - gemini-3-pro (Latest, best quality, paid tier recommended)
# - gemini-2.5-pro (Good quality, paid tier)
# - gemini-2.5-flash (Fast, good quality)
# - gemini-2.0-flash (Fallback, free tier)
GEMINI_MODEL="gemini-3-pro"
STABILITY_API_KEY="your-stability-ai-api-key"

# AI Cost Management
MAX_DAILY_AI_COST="10.0"

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# File Upload
MAX_FILE_SIZE="10mb"
UPLOAD_DIR="./uploads"
