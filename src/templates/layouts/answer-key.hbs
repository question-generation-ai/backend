<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @page {
            margin: 0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            font-size: 11pt;
            line-height: 1.5;
            color: #000;
            background: #fff;
        }

        .page-header {
            text-align: center;
            padding: 20px;
            border-bottom: 3px double #000;
            margin-bottom: 20px;
            background: linear-gradient(to bottom, #f0f9ff, #ffffff);
        }

        .school-name {
            font-size: 20pt;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .exam-title {
            font-size: 16pt;
            font-weight: bold;
            margin: 10px 0;
            color: #1e40af;
        }

        .exam-details {
            display: flex;
            justify-content: space-around;
            margin-top: 15px;
            font-size: 11pt;
        }

        .detail-item {
            flex: 1;
        }

        .question-section {
            margin: 25px 0;
            padding: 15px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            background: #fafafa;
            page-break-inside: avoid;
        }

        .question-header {
            font-weight: bold;
            margin-bottom: 8px;
            font-size: 13pt;
            color: #1e40af;
        }

        .question-text {
            margin-bottom: 12px;
            text-align: justify;
            padding: 10px;
            background: #fff;
            border-left: 3px solid #1e40af;
        }

        .question-image {
            text-align: center;
            margin: 15px 0;
        }

        .question-image img {
            max-width: 100%;
            max-height: 300px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .answer-box {
            margin: 15px 0;
            padding: 15px;
            background: linear-gradient(to right, #dcfce7, #f0fdf4);
            border-left: 5px solid #16a34a;
            border-radius: 4px;
        }

        .answer-label {
            font-weight: bold;
            color: #15803d;
            font-size: 13pt;
            display: block;
            margin-bottom: 5px;
        }

        .answer-text {
            font-size: 12pt;
            color: #166534;
        }

        .explanation-box {
            margin: 15px 0;
            padding: 15px;
            background: linear-gradient(to right, #dbeafe, #eff6ff);
            border-left: 5px solid #2563eb;
            border-radius: 4px;
        }

        .explanation-label {
            font-weight: bold;
            color: #1e40af;
            font-size: 12pt;
            display: block;
            margin-bottom: 5px;
        }

        .explanation-text {
            font-size: 11pt;
            color: #1e3a8a;
            line-height: 1.7;
        }

        .metadata {
            margin-top: 10px;
            padding: 8px;
            background: #f5f5f5;
            border-radius: 4px;
            font-size: 10pt;
            color: #666;
        }

        .metadata-item {
            display: inline-block;
            margin-right: 15px;
        }

        .page-footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            text-align: center;
            font-size: 10pt;
            padding: 10px;
            border-top: 1px solid #000;
            background: #fff;
        }

        .confidential-mark {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 80pt;
            color: rgba(220, 38, 38, 0.08);
            z-index: -1;
            pointer-events: none;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <div class="page-header">
        <div class="school-name">{{schoolName}}</div>
        <div class="exam-title">{{title}}</div>
        <div class="exam-details">
            <div class="detail-item"><strong>Subject:</strong> {{subject}}</div>
            {{#if chapter}}
            <div class="detail-item"><strong>Chapter:</strong> {{chapter}}</div>
            {{/if}}
            <div class="detail-item"><strong>Date:</strong> {{examDate}}</div>
            <div class="detail-item"><strong>Total Questions:</strong> {{totalQuestions}}</div>
        </div>
    </div>

    <!-- Sections & Answers -->
    {{#each sections}}
    <div style="border-bottom: 2px solid #1e40af; margin: 30px 0 15px 0; padding-bottom: 5px;">
        <h2 style="font-size: 14pt; text-transform: uppercase; color: #1e40af;">Section {{this.sectionLetter}}:
            {{this.sectionTitle}}</h2>
    </div>

    {{#each this.questions}}
    <div class="question-section">
        <div class="question-header">Question {{../sectionLetter}}.{{inc @index}}</div>

        <div class="question-text">
            {{this.question}}
        </div>

        {{#if this.imageUrl}}
        <div class="question-image">
            <img src="{{this.imageUrl}}" alt="Question Image">
        </div>
        {{/if}}

        <div class="answer-box">
            <span class="answer-label">✓ Correct Answer:</span>
            <span class="answer-text">{{this.correct_answer}}{{this.answer}}</span>
        </div>

        {{#if this.explanation}}
        <div class="explanation-box">
            <span class="explanation-label">💡 Explanation:</span>
            <div class="explanation-text">{{this.explanation}}</div>
        </div>
        {{/if}}

        {{#if this.hint}}
        <div class="explanation-box">
            <span class="explanation-label">💭 Hint:</span>
            <div class="explanation-text">{{this.hint}}</div>
        </div>
        {{/if}}

        <div class="metadata">
            <span class="metadata-item"><strong>Type:</strong> {{this.type}}</span>
            {{#if this.difficulty_score}}
            <span class="metadata-item"><strong>Difficulty:</strong> {{this.difficulty_score}}/5</span>
            {{/if}}
        </div>
    </div>
    {{/each}}
    {{/each}}

    <!-- Confidential Watermark -->
    <div class="confidential-mark">ANSWER KEY</div>
</body>

</html>